{
  "foamSolver": {
    "prefix": "foamSolver",
    "body": [
      "#include \"fvCFD.H\"",
      "",
      "int main(int argc, char *argv[])",
      "{",
      "    #include \"setRootCase.H\"",
      "    #include \"createTime.H\"",
      "    #include \"createMesh.H\"",
      "",
      "    Info<< nl << \"Start \" << runTime.name() << nl << endl;",
      "",
      "    ${0:// solver body}",
      "",
      "    Info<< \"End\\n\" << endl;",
      "    return 0;",
      "}"
    ],
    "description": "OpenFOAM 求解器最小骨架"
  },
  "foamPimple": {
    "prefix": "foamPimple",
    "body": [
      "#include \"pimpleControl.H\"",
      "",
      "pimpleControl pimple(mesh);",
      "",
      "while (pimple.loop())",
      "{",
      "    #include \"CourantNo.H\"",
      "",
      "    while (pimple.correct())",
      "    {",
      "        ${0:// pressure-velocity solve}",
      "    }",
      "",
      "    runTime.write();",
      "}"
    ],
    "description": "PIMPLE 循环骨架(可压/不可压求解器)"
  },
  "foamSimple": {
    "prefix": "foamSimple",
    "body": [
      "#include \"simpleControl.H\"",
      "",
      "simpleControl simple(mesh);",
      "",
      "while (simple.loop())",
      "{",
      "    ${0:// SIMPLE 迭代体}",
      "}",
      "",
      "runTime.write();"
    ],
    "description": "SIMPLE 循环骨架(稳态求解器)"
  },
  "foamReadDict": {
    "prefix": "foamReadDict",
    "body": [
      "IOdictionary ${1:properties}",
      "(",
      "    IOobject",
      "    (",
      "        \"${1:properties}\",",
      "        runTime.constant(),",
      "        mesh,",
      "        IOobject::MUST_READ_IF_MODIFIED,",
      "        IOobject::NO_WRITE",
      "    )",
      ");",
      "",
      "const dimensionedScalar ${2:nu}(${1:properties}.lookup(\"${2:nu}\"));"
    ],
    "description": "读取字典并取参(IOdictionary)"
  },
  "foamCreateField": {
    "prefix": "foamCreateField",
    "body": [
      "volScalarField ${1:field}",
      "(",
      "    IOobject",
      "    (",
      "        \"${1:field}\",",
      "        runTime.timeName(),",
      "        mesh,",
      "        IOobject::MUST_READ,",
      "        IOobject::AUTO_WRITE",
      "    ),",
      "    mesh,",
      "    dimensionedScalar(dimless, Zero)",
      ");"
    ],
    "description": "创建 volScalarField 场"
  },
  "foamRunTime": {
    "prefix": "foamRunTime",
    "body": [
      "while (runTime.run())",
      "{",
      "    runTime++;",
      "",
      "    ${0:// solve}",
      "",
      "    runTime.write();",
      "}"
    ],
    "description": "runTime 时间推进循环"
  },
  "foamInfo": {
    "prefix": "foamInfo",
    "body": ["Info<< \"${1:message}\" << ${2:endl};"],
    "description": "Info 输出"
  },
  "foamFatal": {
    "prefix": "foamFatal",
    "body": [
      "FatalErrorInFunction",
      "    << \"${1:message}\"",
      "    << abort(FatalError);"
    ],
    "description": "函数内致命错误退出"
  },
  "foamForAll": {
    "prefix": "foamForAll",
    "body": [
      "forAll(${1:list}, ${2:i})",
      "{",
      "    ${0}",
      "}"
    ],
    "description": "forAll 遍历"
  },
  "foamTurbulence": {
    "prefix": "foamTurbulence",
    "body": [
      "turbulence->correct();",
      "",
      "volScalarField::Internal ${1:divR}(fvc::div(turbulence->divDevReff(U)));"
    ],
    "description": "湍流模型校正与雷诺应力散度"
  }
}
