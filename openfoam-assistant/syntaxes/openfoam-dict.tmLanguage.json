{
  "name": "OpenFOAM Dictionary",
  "scopeName": "source.openfoam-dict",
  "patterns": [
    {
      "name": "comment.block",
      "begin": "/\\*",
      "end": "\\*/"
    },
    {
      "name": "comment.line",
      "match": "//.*$"
    },
    {
      "name": "string.quoted",
      "begin": "\"",
      "end": "\""
    },
    {
      "name": "keyword.control.directive",
      "match": "#[A-Za-z]+"
    },
    {
      "name": "variable.language.macro",
      "match": "\\$[A-Za-z_][A-Za-z0-9_]*"
    },
    {
      "name": "constant.numeric.dimensions",
      "match": "\\[[\\d\\s\\-]+\\]"
    },
    {
      "name": "constant.numeric",
      "match": "\\b[+-]?(?:\\d+\\.?\\d*|\\d*\\.?\\d+)(?:[Ee][+-]?\\d+)?\\b"
    },
    {
      "name": "keyword.operator",
      "match": ";"
    },
    {
      "name": "support.type.qualifier",
      "match": "\\b(on|off|yes|no|true|false|uniform|nonuniform)\\b"
    },
